# Databricks workspace URL, without a trailing slash.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com

# Create this from your Databricks SQL warehouse connection details.
# Serverless Starter Warehouse (find yours under SQL Warehouses -> Connection details)
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# Keep this in .env only. Do not commit a real token.
DATABRICKS_TOKEN=
